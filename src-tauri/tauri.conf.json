{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WBS Gantt",
  "version": "0.1.3",
  "identifier": "com.wbsgantt.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "WBS · Gantt",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwMzhFOTkyRUQ3NjIyMApSV1FnWXRjdW1ZNERDZ3c2Z1JNLzc1c2IvYlZsNm9GaXhybElIem9seER4bExSWEpxc0hrTXpXTwo=",
      "endpoints": [
        "https://github.com/inflammationP/wbs-gantt/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

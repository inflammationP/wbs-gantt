+import { useState } from 'react'
+import { Modal, Field, inputCls } from './ui'
+import { WeekdayPicker, toggleWeekday } from './WeekdayPicker'
+import { useStore } from '../store/useStore'
+import { CustomReminder, ReminderLink } from '../types'
+import { ALL_DAYS, routineRows } from '../lib/habits'
+import { byPlan } from '../lib/chores'
+import { useT } from '../lib/useT'
+
+const areaCls = inputCls.replace('h-8', '')
+
+/** What the `<select>` holds: `''` for no link, `<kind>:<id>` for one. */
+function readLink(value: string): ReminderLink | null {
+  const [kind, id] = value.split(':')
+  if ((kind !== 'habit' && kind !== 'chore') || !id) return null
+  return { kind, id }
+}
+
+const writeLink = (link: ReminderLink | null) => (link ? `${link.kind}:${link.id}` : '')
+
+/**
+ * Write one reminder: what it says, when, and what it is about.
+ *
+ * One dialog for creating and for editing, as the routine editor is and for the
+ * same reason — a pair would be two answers to "what is a reminder made of".
+ *
+ * The link is optional and is the whole of what makes this more than a phone
+ * alarm: tied to a routine or a chore, the reminder goes quiet once the thing is
+ * done, and stays quiet on days it is not on. "Nothing in particular" is the
+ * default, because a reminder about something the app has never heard of is a
+ * perfectly good thing to want.
+ *
+ * Deleting is here rather than on the row, and asks nothing first: a reminder is
+ * a line of text, and a confirm over one costs more than retyping it. The list
+ * is one screen away, which is where its absence is noticed.
+ */
+export function CustomReminderDialog({
+  reminder,
+  onClose,
+}: {
+  /** Absent means a new one — nothing to delete, and no switch to show. */
+  reminder?: CustomReminder
+  onClose: () => void
+}) {
+  const t = useT()
+  const habits = useStore((s) => s.habits)
+  const chores = useStore((s) => s.chores)
+  const addCustomReminder = useStore((s) => s.addCustomReminder)
+  const updateCustomReminder = useStore((s) => s.updateCustomReminder)
+  const deleteCustomReminder = useStore((s) => s.deleteCustomReminder)
+
+  const [text, setText] = useState(reminder?.text ?? '')
+  const [time, setTime] = useState(reminder?.time ?? '')
+  const [weekdays, setWeekdays] = useState<number[]>(reminder?.weekdays ?? [...ALL_DAYS])
+  const [link, setLink] = useState<string>(writeLink(reminder?.link ?? null))
+
+  // Every routine, tree and all — a heading is a perfectly good thing to be
+  // reminded about: its own answer is "everything under it is ticked".
+  const routineOptions = routineRows(habits, null)
+  // Open chores only: tying a reminder to one that is already done would be
+  // tying it to something that will never speak again. The exception is the one
+  // this reminder is *already* on — dropping it out of the list would quietly
+  // turn the link into "nothing in particular" the next time this is saved.
+  const choreOptions = chores
+    .filter((c) => !c.done || c.id === reminder?.link?.id)
+    .sort(byPlan)
+
+  const valid = text.trim().length > 0 && time !== ''
+
+  const save = () => {
+    if (!valid) return
+    const values = { text: text.trim(), time, weekdays, link: readLink(link) }
+    if (reminder) updateCustomReminder(reminder.id, values)
+    else addCustomReminder(values)
+    onClose()
+  }
+
+  return (
+    <Modal title={reminder ? t('reminder.edit') : t('reminder.new')} onClose={onClose} width={440}>
+      <div className="space-y-3">
+        <Field label={t('reminder.text')}>
+          <textarea
+            autoFocus
+            className={`${areaCls} h-20 resize-none leading-relaxed`}
+            value={text}
+            placeholder={t('reminder.textPlaceholder')}
+            onChange={(e) => setText(e.target.value)}
+          />
+        </Field>
+
+        <Field label={t('reminder.time')}>
+          {/* Native, so the platform's own picker is what appears — 12-hour or
+              24-hour according to how the machine is set up. The value it reads
+              and writes is `HH:mm`, which is the shape the data keeps. */}
+          <input type="time" className={inputCls} value={time} onChange={(e) => setTime(e.target.value)} />
+        </Field>
+
+        <Field label={t('habit.weekdays')}>
+          <WeekdayPicker days={weekdays} onToggle={(i) => setWeekdays((days) => toggleWeekday(days, i))} />
+        </Field>
+
+        {/* A `<select>` rather than a foldable tree, as in the routine editor:
+            the list is a handful of things and indenting the names already says
+            which is inside which. Two groups under "nothing in particular",
+            which is first because it is the default. */}
+        <Field label={t('reminder.link')}>
+          <select className={inputCls} value={link} onChange={(e) => setLink(e.target.value)}>
+            <option value="">{t('reminder.linkNone')}</option>
+            {routineOptions.length > 0 && (
+              <optgroup label={t('habit.section')}>
+                {routineOptions.map((r) => (
+                  <option key={r.habit.id} value={`habit:${r.habit.id}`}>
+                    {'  '.repeat(r.depth)}
+                    {r.habit.title}
+                  </option>
+                ))}
+              </optgroup>
+            )}
+            {choreOptions.length > 0 && (
+              <optgroup label={t('chore.section')}>
+                {choreOptions.map((c) => (
+                  <option key={c.id} value={`chore:${c.id}`}>
+                    {c.title}
+                  </option>
+                ))}
+              </optgroup>
+            )}
+          </select>
+        </Field>
+
+        <div className="flex items-center gap-2 pt-1">
+          {reminder && (
+            <button
+              onClick={() => {
+                deleteCustomReminder(reminder.id)
+                onClose()
+              }}
+              className="mr-auto h-8 px-3 text-[12px] text-delayed hover:text-fg border border-border rounded-[3px]"
+            >
+              {t('common.delete')}
+            </button>
+          )}
+          <button
+            onClick={onClose}
+            className="h-8 px-3 text-[12px] text-muted hover:text-fg border border-border rounded-[3px]"
+          >
+            {t('common.cancel')}
+          </button>
+          <button
+            onClick={save}
+            disabled={!valid}
+            className="h-8 px-4 text-[12px] font-medium bg-accent text-on-accent disabled:opacity-40 disabled:cursor-default rounded-[3px]"
+          >
+            {t('common.save')}
+          </button>
+        </div>
+      </div>
+    </Modal>
+  )
+}

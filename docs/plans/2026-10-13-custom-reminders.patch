+/**
+ * The check on the reminders the user wrote — run with
+ * `node scripts/check-custom-reminders.mjs`.
+ *
+ * One question is pinned here, and it is the whole of what makes a written
+ * reminder more than a phone alarm: **does today need reminding about this at
+ * all?** Every answer is silence, and silence looks exactly like a reminder that
+ * was never set, a machine that was asleep, or a file the sender could not read.
+ * So each rule that produces it is asserted rather than left to the day it
+ * happens to be tried on: a routine that is not on today, one that is already
+ * ticked, a heading whose children are all done, a chore that is finished or was
+ * never today's.
+ *
+ * The windows are here too, because they are what stands in for a lateness rule
+ * in the sender: a reminder is worth delivering for an hour after its time and
+ * not past midnight, and both ends of that are arithmetic on `HH:mm` strings
+ * that nothing else would ever catch.
+ *
+ * Loaded from source by Vite like the other checks. The clock is not frozen and
+ * does not need to be — every date is passed in — but the fixture's week is
+ * check-habits' week, so the weekday assertions are timeless.
+ */
+import assert from 'node:assert/strict'
+import { createServer } from 'vite'
+
+const server = await createServer({
+  server: { middlewareMode: true },
+  appType: 'custom',
+  logLevel: 'error',
+  optimizeDeps: { entries: [] },
+})
+const { customRemindersOn, reminderMessages, reminderWindow, windowEnd, linkName } =
+  await server.ssrLoadModule('/src/lib/customReminders.ts')
+const { weekdayIndex } = await server.ssrLoadModule('/src/lib/dates.ts')
+await server.close()
+
+// 2026-09-22 is the Tuesday `check-habits.mjs` is built around.
+const TUE = '2026-09-22'
+const WED = '2026-09-23'
+const MON = '2026-09-28'
+const ALL = [0, 1, 2, 3, 4, 5, 6]
+const WORDS = { title: '提醒', habit: '日常安排', chore: '临时事务' }
+
+// The fixture's weekdays are derived, not assumed: an off-by-one in the
+// Monday-first convention would otherwise move every assertion by a day and
+// leave most of them passing.
+assert.equal(weekdayIndex(new Date(2026, 8, 22)), 1, 'the fixture is a Tuesday')
+assert.equal(weekdayIndex(new Date(2026, 8, 28)), 0, 'and 09-28 is the Monday after it')
+
+const habit = (over) => ({
+  id: 'h',
+  title: '刷牙',
+  note: '',
+  parentId: null,
+  startDate: '2026-01-01',
+  endDate: null,
+  weekdays: [...ALL],
+  paused: false,
+  pauseDate: null,
+  pauses: [],
+  doneDays: [],
+  createdAt: '2026-01-01T00:00:00.000Z',
+  updatedAt: '',
+  ...over,
+})
+const chore = (over) => ({
+  id: 'c',
+  title: '交表',
+  note: '',
+  date: TUE,
+  slot: null,
+  time: null,
+  done: false,
+  completedDate: null,
+  createdAt: '2026-01-01T00:00:00.000Z',
+  updatedAt: '',
+  ...over,
+})
+const rem = (over) => ({
+  id: 'r',
+  text: '放下手中的活先把牙刷了',
+  time: '20:00',
+  weekdays: [...ALL],
+  link: null,
+  enabled: true,
+  createdAt: '2026-01-01T00:00:00.000Z',
+  updatedAt: '',
+  ...over,
+})
+
+const fires = (r, ctx, day) => customRemindersOn([r], ctx, day).length > 0
+const ctx = (over) => ({ habits: [], chores: [], ...over })
+
+// ── the reminder's own days ──────────────────────────────────────────────────
+
+assert.equal(fires(rem(), ctx(), TUE), true, 'every day means every day')
+assert.equal(fires(rem({ weekdays: [0] }), ctx(), TUE), false, 'Monday is not Tuesday')
+assert.equal(fires(rem({ weekdays: [0] }), ctx(), MON), true)
+assert.equal(fires(rem({ enabled: false }), ctx(), TUE), false, 'switched off is switched off')
+
+// ── tied to a routine ────────────────────────────────────────────────────────
+
+const habitCtx = (h, over) => ctx({ habits: [h], ...over })
+const linked = (over) => rem({ link: { kind: 'habit', id: 'h' }, ...over })
+
+// Not on today at all: not one of its days, suspended on the day, or finished
+// with. A reminder about something that is not on the day is a reminder about
+// nothing.
+assert.equal(fires(linked(), habitCtx(habit({ weekdays: [0] })), TUE), false, 'not its weekday')
+assert.equal(
+  fires(linked(), habitCtx(habit({ paused: true, pauseDate: '2026-09-01' })), TUE),
+  false,
+  'suspended that day',
+)
+assert.equal(fires(linked(), habitCtx(habit({ endDate: '2026-09-01' })), TUE), false, 'over before today')
+
+assert.equal(fires(linked(), habitCtx(habit()), TUE), true, 'on today and not ticked')
+assert.equal(fires(linked(), habitCtx(habit({ doneDays: [TUE] })), TUE), false, 'ticked already: nothing left to say')
+// The tick is the day's, not the habit's: yesterday's tick says nothing about
+// today, which is the difference between a routine and a chore.
+assert.equal(fires(linked(), habitCtx(habit({ doneDays: ['2026-09-21'] })), TUE), true)
+
+// A heading's answer is its children's, and `routineRows` is where that is
+// decided — a second count here would be a second answer.
+const tree = [habit({ id: 'head', title: '早上' }), habit({ id: 'h', title: '刷牙', parentId: 'head' })]
+assert.equal(fires(linked(), ctx({ habits: tree }), TUE), true, 'a heading with work left under it')
+assert.equal(
+  fires(linked(), ctx({ habits: [tree[0], { ...tree[1], doneDays: [TUE] }] }), TUE),
+  false,
+  'a heading whose children are all ticked',
+)
+
+// Gone: read as no link rather than as silence. The sentence is the user's own.
+assert.equal(fires(linked(), habitCtx(habit({ id: 'other' })), TUE), true, 'the routine it named is gone')
+
+// ── tied to a chore ──────────────────────────────────────────────────────────
+
+const choreCtx = (c) => ctx({ chores: [c] })
+const choreLinked = (over) => rem({ link: { kind: 'chore', id: 'c' }, ...over })
+
+assert.equal(fires(choreLinked(), choreCtx(chore({ date: WED })), TUE), false, 'written for tomorrow')
+assert.equal(fires(choreLinked(), choreCtx(chore({ date: '2026-09-18' })), TUE), true, 'carried over, still open')
+assert.equal(
+  fires(choreLinked(), choreCtx(chore({ done: true, completedDate: TUE })), TUE),
+  false,
+  'finished today: nothing left to say',
+)
+assert.equal(
+  fires(choreLinked(), choreCtx(chore({ date: '2026-09-18', done: true, completedDate: '2026-09-18' })), TUE),
+  false,
+  'finished days ago',
+)
+assert.equal(fires(choreLinked(), choreCtx(chore({ id: 'other' })), TUE), true, 'the chore it named is gone')
+
+// The two decisions are kept apart: the reminder's own days and the linked
+// thing's schedule both have to hold.
+assert.equal(fires(choreLinked({ weekdays: [0] }), choreCtx(chore()), TUE), false)
+
+// ── what it says ─────────────────────────────────────────────────────────────
+
+const [alone] = reminderMessages([rem()], ctx(), TUE, WORDS)
+assert.equal(alone.title, WORDS.title)
+assert.equal(alone.body, '放下手中的活先把牙刷了', 'a reminder about nothing else is just the sentence')
+assert.equal(alone.from, '20:00')
+assert.equal(alone.to, '21:00')
+
+const [tied] = reminderMessages([linked()], habitCtx(habit()), TUE, WORDS)
+assert.equal(tied.body, '放下手中的活先把牙刷了\n日常安排 · 刷牙', 'and one that names something says what')
+// A broken link prints no line at all, rather than the word for a name that is
+// not there: the sentence stands on its own.
+assert.equal(linkName(linked(), habitCtx(habit({ id: 'gone' }))), null)
+assert.equal(reminderMessages([linked()], habitCtx(habit({ id: 'gone' })), TUE, WORDS)[0].body, '放下手中的活先把牙刷了')
+
+// ── the window, which is the lateness rule ───────────────────────────────────
+
+assert.equal(windowEnd('20:00'), '21:00')
+assert.equal(windowEnd('07:30'), '08:30')
+assert.equal(windowEnd('23:00'), '24:00', 'the window never runs past the end of the day')
+assert.equal(windowEnd('23:30'), '24:00', 'and a late reminder gets what is left of it')
+
+// ── the fortnight the file holds ─────────────────────────────────────────────
+
+const window = reminderWindow([rem({ weekdays: [0, 2] })], ctx(), TUE, 14, WORDS)
+assert.deepEqual(
+  Object.keys(window),
+  // Mondays and Wednesdays (`0` and `2`, Monday-first) over the fortnight that
+  // starts on the Tuesday: the 23rd and 30th are Wednesdays, the 28th and the
+  // 5th of October are Mondays. Nothing else is in the file at all.
+  ['2026-09-23', '2026-09-28', '2026-09-30', '2026-10-05'],
+  'only the days it speaks on are in the file at all',
+)
+assert.equal(window['2026-09-28'][0].id, 'r')
+
+// Two reminders, one day, independent of each other.
+const both = reminderWindow(
+  [rem({ id: 'a', time: '20:00' }), rem({ id: 'b', time: '07:00', enabled: false })],
+  ctx(),
+  TUE,
+  1,
+  WORDS,
+)
+assert.deepEqual(both[TUE].map((m) => m.id), ['a'], 'one switched off does not stop the other')
+
+console.log('custom reminders: all assertions passed')

+import { ALL_DAYS } from '../lib/habits'
+import { weekdayLabels } from '../lib/i18n'
+import { useLang, useT } from '../lib/useT'
+
+/**
+ * The days of the week, as seven buttons you press.
+ *
+ * Seven buttons rather than a component was the call while there was one caller
+ * (`HabitDialog`): the app has no other multi-select, and seven of them is less
+ * code than a component built for one use. There are two callers now — a routine
+ * and a reminder — and the second is what makes it a component: the labels, the
+ * pressed styling and the "never fewer than one" rule are the same in both, and
+ * the rule in particular is one that fails quietly.
+ *
+ * Styled after `Segmented`, the app's only existing "pick one of a few" control.
+ *
+ * `onToggle` absent means the days are being *reported* rather than asked about,
+ * which is what a routine that has children needs: its days are its children's,
+ * so the control is lit from what was derived and takes no clicks. Inert rather
+ * than hidden — the same choice the read-only tick boxes make — so that "these
+ * are the days this runs on" is still readable, and dimmed so that it looks
+ * before the click rather than after it.
+ */
+export function WeekdayPicker({
+  days,
+  onToggle,
+}: {
+  days: number[]
+  onToggle?: (day: number) => void
+}) {
+  const t = useT()
+  const labels = weekdayLabels(useLang())
+  return (
+    <>
+      <div className="flex items-center gap-1">
+        {labels.map((label, i) => {
+          const on = days.includes(i)
+          return (
+            <button
+              key={label}
+              type="button"
+              disabled={!onToggle}
+              onClick={() => onToggle?.(i)}
+              aria-pressed={on}
+              className={`flex-1 h-7 text-[11px] font-medium rounded-[3px] border transition-colors ${
+                on ? 'bg-accent/15 text-accent border-accent/40' : 'bg-panel2 text-muted border-border'
+              } ${onToggle ? 'hover:text-fg' : 'opacity-70'}`}
+            >
+              {label}
+            </button>
+          )
+        })}
+      </div>
+      <div className="text-[11px] text-dim mt-1">
+        {days.length === ALL_DAYS.length ? t('habit.everyDay') : ''}
+      </div>
+    </>
+  )
+}
+
+/**
+ * The days after one of them is clicked: on becomes off, off becomes on, and the
+ * last one on never goes off.
+ *
+ * Every day off is not a schedule, it is someone who has not finished thinking,
+ * and the state it would leave behind — a routine that never runs, a reminder
+ * that never speaks — is one nothing downstream can make sense of. The rule
+ * lives here rather than in each caller's click handler because there is nothing
+ * about it that differs between them.
+ */
+export function toggleWeekday(days: number[], day: number): number[] {
+  if (!days.includes(day)) return [...days, day].sort((a, b) => a - b)
+  return days.length > 1 ? days.filter((d) => d !== day) : days
+}

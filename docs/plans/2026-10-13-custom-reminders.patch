--- base/src/lib/customReminders.ts	1970-01-01 08:00:00.000000000 +0800
+++ wip/src/lib/customReminders.ts	2026-10-13 11:54:21.661658300 +0800
@@ -0,0 +1,200 @@
+import { Chore, CustomReminder, Habit } from '../types'
+import { addDays, toDate, toISO, weekdayIndex } from './dates'
+import { routineRows } from './habits'
+import { todaysChores } from './chores'
+
+/**
+ * Custom reminders: which day one speaks on, and what it says.
+ *
+ * A file of its own rather than a corner of `reminder.ts`, which is the digest
+ * side's and opens with the slots, the greetings and the copy table — none of
+ * which a reminder the user wrote has anything to do with. What the two share
+ * is the *delivery* (a file of pre-rendered messages and a process that picks
+ * one by the clock), and that lives in `notify.ts`.
+ *
+ * The one rule this file exists for: **a reminder tied to a routine or a chore
+ * goes quiet when there is nothing left to remind about** — done, not on today,
+ * or gone. The tie never adds anything to the sentence; it only ever takes the
+ * send away. See `CustomReminder` in types.ts.
+ */
+
+/** The words the second line is written with, in the app's own language. */
+export interface ReminderWords {
+  /** The notification's title — what the message is, since the body is prose. */
+  title: string
+  /** What a routine is called on screen, and what a chore is called. */
+  habit: string
+  chore: string
+}
+
+/** What a day's rules are read against: the two collections a link can name. */
+export interface ReminderContext {
+  habits: Habit[]
+  chores: Chore[]
+}
+
+/**
+ * How long after its time a reminder is still worth delivering.
+ *
+ * The scheduled task fires every fifteen minutes, so a reminder is normally
+ * early or up to a quarter of an hour late. This covers the other case — the
+ * machine was asleep or off at the time — and it is deliberately not "the rest
+ * of the day": "put down what you are doing and brush your teeth" arriving at
+ * eleven at night is not a reminder, it is noise, and a machine that was off
+ * overnight would deliver a pile of them at breakfast.
+ *
+ * An hour, and not ten minutes, because the thing being waited for is a person
+ * getting back to their desk rather than a packet arriving.
+ */
+export const LATE_MINUTES = 60
+
+/**
+ * When a reminder's window closes: its time plus `LATE_MINUTES`, as `HH:mm`.
+ *
+ * Clamped to `24:00` — the same sentinel the slot table uses for the end of the
+ * day, and a window that must not run over midnight. A reminder at 23:30 is
+ * therefore worth fifteen minutes, not an hour, which is right: the day it was
+ * set for is the day it is about.
+ */
+export function windowEnd(time: string): string {
+  const [h, m] = time.split(':').map((n) => parseInt(n, 10) || 0)
+  const end = h * 60 + m + LATE_MINUTES
+  if (end >= 24 * 60) return '24:00'
+  return `${String(Math.floor(end / 60)).padStart(2, '0')}:${String(end % 60).padStart(2, '0')}`
+}
+
+/**
+ * What a reminder is tied to, as the name the notification prints — or null.
+ *
+ * Null covers both "there is no link" and "the link names something that is not
+ * there any more", because the second is read as the first: the sentence is the
+ * user's own, and it does not stop meaning something because the routine it was
+ * written beside was deleted. The settings list is where a broken link is
+ * visible; this only decides whether there is a name to print.
+ */
+export function linkName(reminder: CustomReminder, ctx: ReminderContext): { kind: string; name: string } | null {
+  const link = reminder.link
+  if (!link) return null
+  const found =
+    link.kind === 'habit'
+      ? ctx.habits.find((h) => h.id === link.id)?.title
+      : ctx.chores.find((c) => c.id === link.id)?.title
+  return found == null ? null : { kind: link.kind, name: found }
+}
+
+/**
+ * Whether this reminder should speak on `day`.
+ *
+ * Three questions, and all of them have to be yes:
+ *
+ *  - **Is it one of its days?** The reminder's own `weekdays`, which is a
+ *    different decision from the linked item's schedule and is kept separate:
+ *    "when do I want to be nagged" and "when is this thing on" are two things to
+ *    answer, and the answer is the intersection.
+ *  - **Is what it is about on this day at all?** A routine that does not run
+ *    today — not its weekday, suspended, finished with — is not something to be
+ *    reminded about, and neither is a chore that is not on the day's plate.
+ *  - **Is it already done?** Nothing left to say. For a routine that is a
+ *    heading this is "every routine under it is ticked", which is `routineRows`'
+ *    own answer and not a second count kept here.
+ *
+ * `rows` is the day's routine tree, computed once by the caller: every reminder
+ * on a day asks the same question of the same collection.
+ */
+function firesOnDay(
+  reminder: CustomReminder,
+  day: string,
+  ctx: ReminderContext,
+  rows: ReturnType<typeof routineRows>,
+): boolean {
+  if (!reminder.enabled) return false
+  if (!reminder.weekdays.includes(weekdayIndex(toDate(day)))) return false
+
+  const link = reminder.link
+  if (!link) return true
+
+  if (link.kind === 'habit') {
+    // Gone entirely: read as no link, and the sentence still stands.
+    if (!ctx.habits.some((h) => h.id === link.id)) return true
+    const row = rows.find((r) => r.habit.id === link.id)
+    return row != null && !row.done
+  }
+
+  const chore = ctx.chores.find((c) => c.id === link.id)
+  if (!chore) return true
+  // On the day's plate at all — a chore written for tomorrow is not today's
+  // business — and not already ticked. A chore that is open carries over, so
+  // the days it slipped through are days it still speaks on.
+  return todaysChores([chore], day).length > 0 && !chore.done
+}
+
+/** `day`'s reminders, in the order they were written. */
+export function customRemindersOn(
+  reminders: CustomReminder[],
+  ctx: ReminderContext,
+  day: string,
+): CustomReminder[] {
+  const rows = routineRows(ctx.habits, day)
+  return reminders.filter((r) => firesOnDay(r, day, ctx, rows))
+}
+
+/** One message, as the sender reads it: a window to land in and the text. */
+export interface ReminderMessage {
+  id: string
+  from: string
+  to: string
+  title: string
+  body: string
+}
+
+/**
+ * `day`'s messages, ready to be written into the file.
+ *
+ * Days with nothing to say are absent rather than empty, the same convention the
+ * digests use. The sender therefore needs no idea what a routine is: it asks
+ * which message's window holds the current minute, and everything about *whether
+ * today is a day for this* was settled here.
+ */
+export function reminderMessages(
+  reminders: CustomReminder[],
+  ctx: ReminderContext,
+  day: string,
+  words: ReminderWords,
+): ReminderMessage[] {
+  return customRemindersOn(reminders, ctx, day).map((r) => {
+    const link = linkName(r, ctx)
+    return {
+      id: r.id,
+      from: r.time,
+      to: windowEnd(r.time),
+      title: words.title,
+      // The sentence, and under it what it is about — a name the sentence
+      // usually does not carry, and the only thing that tells two reminders
+      // apart when they are about the same kind of thing.
+      body: link ? `${r.text}\n${link.kind === 'habit' ? words.habit : words.chore} · ${link.name}` : r.text,
+    }
+  })
+}
+
+/**
+ * The next `days` days of messages, keyed by day.
+ *
+ * The same window the digests are rendered for, and for the same reason: the
+ * file has to outlive the app being closed, and a file holding only today would
+ * be useless by tomorrow morning — which is exactly when it is needed.
+ */
+export function reminderWindow(
+  reminders: CustomReminder[],
+  ctx: ReminderContext,
+  from: string,
+  days: number,
+  words: ReminderWords,
+): Record<string, ReminderMessage[]> {
+  const out: Record<string, ReminderMessage[]> = {}
+  for (let i = 0; i < days; i++) {
+    const day = toISO(addDays(toDate(from), i))
+    const messages = reminderMessages(reminders, ctx, day, words)
+    if (messages.length) out[day] = messages
+  }
+  return out
+}
